        <mxCell id="2Mc3mfCmb9zWbBxzdANr-4" value="&lt;b&gt;&lt;font&gt;JUMP DECOMPOSITION&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;i&gt;REALIZED VARIANCE:&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;RV&lt;sub&gt;t&lt;/sub&gt; =&amp;nbsp;Σ r&lt;sub&gt;t, i&lt;/sub&gt; &lt;sup&gt;2&amp;nbsp;&lt;/sup&gt;&lt;/div&gt;&lt;div&gt;&lt;sup&gt;&lt;br&gt;&lt;/sup&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;i&gt;BIPOWER VARIATION:&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;BV&lt;sub&gt;t&lt;/sub&gt; = (&lt;span style=&quot;color: rgb(32, 33, 34); font-family: sans-serif; font-size: 16px; text-align: start;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Nimbus Roman No9 L&amp;quot;, &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 18.88px; line-height: 1; font-variant-numeric: lining-nums tabular-nums; font-kerning: none; text-wrap-mode: nowrap; font-style: italic;&quot; class=&quot;texhtml mvar&quot;&gt;π&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(32, 33, 34); text-align: start;&quot;&gt;&lt;span class=&quot;texhtml mvar&quot; style=&quot;line-height: 1; font-variant-numeric: lining-nums tabular-nums; font-kerning: none; text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;/2)&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Σ&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;|r&lt;sub&gt;t,i&lt;/sub&gt;||r&lt;sub&gt;t,i-1&lt;/sub&gt;|&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;i&gt;CONTINOUS VOLATILITY:&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;C&lt;sub&gt;t&lt;/sub&gt;=BV&lt;sub&gt;t&lt;/sub&gt;&lt;/div&gt;&lt;div&gt;&lt;sub&gt;&lt;br&gt;&lt;/sub&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;i&gt;JUMP VOLATILITY:&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;J&lt;sub&gt;t&lt;/sub&gt;=max(0, RV&lt;sub&gt;t&lt;/sub&gt;-BV&lt;sub&gt;t&lt;/sub&gt;)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Verdana;strokeWidth=2;" vertex="1" parent="1">
