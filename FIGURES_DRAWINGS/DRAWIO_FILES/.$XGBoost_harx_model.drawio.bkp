        <mxCell id="PzP1znnDI115vmmVvs5K-16" value="&lt;div&gt;&lt;font style=&quot;font-size: 47px;&quot; face=&quot;Verdana&quot;&gt;Initial Model (Baseline Volatility)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 47px;&quot; face=&quot;Verdana&quot;&gt;&lt;div&gt;$$f_0(X_t) = c$$&lt;/div&gt;&lt;div&gt;c= Constant log variance&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 47px;&quot;&gt;$$r_t^{(m)} = y_t - f_{m-1}(X_t)$$&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 47px;&quot;&gt;$$h_m(X_t) \approx r_t^{(m)}$$&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 47px;&quot;&gt;$$f_m(X_t) = f_{m-1}(X_t) + \eta\,h_m(X_t)$$&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 47px;&quot;&gt;$$f(X_t) = f_0 + \sum_{m=1}^{M} \eta\,h_m(X_t)$$&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 47px;&quot;&gt;$$m = 1,2,\dots,M$$ $$M = \text{total number of boosting rounds (trees)}$$&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=4;" parent="1" vertex="1">
          <mxGeometry x="-10" y="20" width="1170" height="1140" as="geometry" />
        </mxCell>
