        <mxCell id="IoanpRgfIsghjecbGdSy-38" value="&lt;div&gt;&lt;font style=&quot;font-size: 90px;&quot; face=&quot;Verdana&quot;&gt;&lt;b style=&quot;&quot;&gt;MULTI - HEAD ATTENTION&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Verdana;&quot;&gt;&lt;font style=&quot;font-size: 90px;&quot;&gt;For each head h:&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Verdana;&quot;&gt;&lt;font style=&quot;font-size: 90px;&quot;&gt;\(Q = ZW_Q\)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Verdana;&quot;&gt;&lt;font style=&quot;font-size: 90px;&quot;&gt;\(K = ZW_K\)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Verdana;&quot;&gt;&lt;font style=&quot;font-size: 90px;&quot;&gt;\(V = ZW_V\)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 90px;&quot; face=&quot;Verdana&quot;&gt;&lt;b&gt;Attention Weights:&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 90px;&quot; face=&quot;Verdana&quot;&gt;$$A = \operatorname{softmax}\!\left(\frac{QK^\top}{\sqrt{d_k}} + M_{\text{mask}}\right)$$&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 90px;&quot; face=&quot;Verdana&quot;&gt;&lt;b&gt;Context:&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 90px;&quot; face=&quot;Verdana&quot;&gt;$$H = AV$$&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 90px;&quot; face=&quot;Verdana&quot;&gt;&lt;b&gt;Multiple Heads:&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 90px;&quot; face=&quot;Verdana&quot;&gt;$$\text{MHSA}(Z) = \operatorname{Concat}(H_1, H_2, \dots, H_H)W_O$$&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 90px;&quot; face=&quot;Verdana&quot;&gt;&lt;b&gt;Block:&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 90px;&quot; face=&quot;Verdana&quot;&gt;$$Z&#39; = \operatorname{LayerNorm}(Z + \text{MHSA}(Z))$$&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=5;" parent="1" vertex="1">
